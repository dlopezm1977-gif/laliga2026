rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /predictions/{userId}/{document=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /scores/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /matches_cache/{matchday} {
      allow read: if true;
      allow write: if false;
    }

    match /scorers_cache/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /season_predictions/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /monthly_predictions/{userId}/{document=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Premios mensuales: los rellena el administrador desde el panel de administración
    match /monthly_results/{monthKey} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'dlopezm1977@gmail.com';
    }

    // Premios anuales (season_results/current): los rellena el administrador
    match /season_results/{document} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'dlopezm1977@gmail.com';
    }

    match /minigames/{gameId} {
      allow read:  if request.auth != null;
      allow write: if false;  // solo desde consola de Firebase
    }

    match /minigame_results/{userId}/{document=**} {
      allow read:  if request.auth != null;        // el ranking lee resultados de todos
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /matches_cache_segunda/{round} {
      allow read: if true;
      allow write: if false;
    }

    match /standings_cache_segunda/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /scorers_cache_segunda/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /matches_cache_rffm/{round} {
      allow read: if true;
      allow write: if false;
    }

    match /standings_cache_rffm/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /scorers_cache_rffm/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /campos_cache_rffm/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Detalle de partido (highlights): el administrador puede corregir los vídeos desde el panel
    match /match_detail_cache_segunda/{matchId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'dlopezm1977@gmail.com';
    }

    match /match_detail_cache_laliga/{matchId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'dlopezm1977@gmail.com';
    }

    match /match_detail_cache_rffm/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /matches_cache_municipal/{round} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'dlopezm1977@gmail.com';
    }

    match /standings_cache_municipal/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /match_videos_rffm/{matchId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'dlopezm1977@gmail.com';
    }

    match /app_config/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /match_videos/{matchKey} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'dlopezm1977@gmail.com';
    }
  }
}

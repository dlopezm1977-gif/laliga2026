rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /predictions/{userId}/{document=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /scores/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /matches_cache/{matchday} {
      allow read: if true;
      allow write: if false;
    }

    match /scorers_cache/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /season_predictions/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /monthly_predictions/{userId}/{document=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /monthly_results/{monthKey} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    match /minigames/{gameId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    match /minigame_results/{userId}/{document=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /matches_cache_segunda/{round} {
      allow read: if true;
      allow write: if false;
    }

    match /standings_cache_segunda/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /scorers_cache_segunda/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /matches_cache_rffm/{round} {
      allow read: if true;
      allow write: if false;
    }

    match /standings_cache_rffm/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /scorers_cache_rffm/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /campos_cache_rffm/{document} {
      allow read: if true;
      allow write: if false;
    }
  }
}
